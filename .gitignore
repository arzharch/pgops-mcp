__pycache__/
*.pyc
*.egg-info/
build/
dist/

# tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.venv/

# secrets / local env
.env

# Signing keys. `pgops-mcp keygen` also drops a `.gitignore` into whatever --key-dir it
# is given, but that is defence in depth, not the primary guard: a key generated by an
# older build, copied in by hand, or written somewhere else entirely would not have one.
# A committed private key stays in the history after it is deleted, so it has to be
# treated as compromised — cheap to prevent, expensive to undo.
keys/
*.pem

# local benchmark runs (CI uploads its own as artifacts)
bench-results/

# Working notes — progress log, phased spec, PRD, interview prep. Kept locally, never
# published: a public repository should show the engineering (docs/, docs/adr/), not the
# author's running status updates.
.private/
