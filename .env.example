# pgops-mcp environment configuration
# Copy to `.env` and fill in real values. Every variable is optional except PGOPS_DSN.
# CLI flags override env vars when both are given.

# --- Required ---------------------------------------------------------------------

# Postgres connection string. This is the database the server operates on.
# The role in this DSN should be least-privilege in production; the server also
# enforces read-only at the session level for all read tools regardless.
PGOPS_DSN=postgresql://user:password@localhost:5432/mydb

# --- Optional: separate read-only role (defense in depth) --------------------------
# If set, read tools use this DSN instead of PGOPS_DSN. Belt-and-suspenders on top of
# the session-level `default_transaction_read_only` guarantee, which holds even for a
# superuser DSN. Leave unset to use PGOPS_DSN for everything.
#PGOPS_READONLY_DSN=postgresql://readonly_user:password@localhost:5432/mydb

# --- Safety flags -------------------------------------------------------------------

# Disable write tools entirely. Removes query.write and migration.apply from the
# advertised tool list AND hard-disables the write pool. Useful for demos, read
# replicas, or handing the server to someone you don't fully trust yet.
# Values: 1/true/yes/on
#PGOPS_READ_ONLY=false

# Permit container mutations (container.restart / container.exec). Off by default
# because Docker socket access is equivalent to root on the host. Even with this on,
# each call still needs a confirmation token.
#PGOPS_APPROVAL_MODE=false

# Confirmation token lifetime in seconds (default 300 = 5 minutes).
#PGOPS_CONFIRM_TOKEN_TTL_S=300

# --- Audit log ----------------------------------------------------------------------

# Where the append-only JSONL audit trail is written.
# Default: ~/.pgops/audit.jsonl
#PGOPS_AUDIT_LOG=/var/log/pgops/audit.jsonl

# --- Timeouts (ms) ------------------------------------------------------------------

# Default statement_timeout applied to every query (default 5000).
#PGOPS_DEFAULT_TIMEOUT_MS=5000
# Hard ceiling no tool call can exceed, however configured (default 30000).
#PGOPS_MAX_TIMEOUT_MS=30000

# --- Row limits ---------------------------------------------------------------------

# Default max rows returned by query.read (default 100).
#PGOPS_DEFAULT_ROW_LIMIT=100
# Hard ceiling on rows returned; exceeding it is a structured error, not a clamp
# (default 10000). Raising this is a deliberate operator decision — the cap is what
# stops "SELECT * FROM orders" from ever being unbounded.
#PGOPS_MAX_ROW_LIMIT=10000

# --- Connection pools ---------------------------------------------------------------

# Readonly pool sizing (defaults 1 min / 5 max). Raise for multiple concurrent MCP
# clients sharing one server; weigh against Postgres max_connections.
#PGOPS_READONLY_POOL_MIN=1
#PGOPS_READONLY_POOL_MAX=5
# Readwrite pool max (default 2). Kept small by design — writes are expected to be
# infrequent and serialized relative to reads.
#PGOPS_READWRITE_POOL_MAX=2
# How long a tool call waits for a free pooled connection before failing with
# POOL_EXHAUSTED, in ms (default 10000).
#PGOPS_POOL_ACQUIRE_TIMEOUT_MS=10000

# --- Observability (optional; requires `uv sync --extra otel`) -----------------------

# OTLP exporter endpoint for traces + metrics (e.g. a local Jaeger/collector).
# Unset = telemetry fully disabled, zero overhead beyond a few dict lookups.
#PGOPS_OTEL_ENDPOINT=http://localhost:4317

# Port for /health (liveness) and /ready (readiness: Postgres reachable right now).
# Unset = no health endpoints. Useful for compose healthchecks / process managers.
#PGOPS_HEALTH_PORT=8080

# Per-caller tool-call rate limit, applied only under HTTP auth (there is one caller
# over stdio, so a limit there is friction with nothing to protect). A tool runs
# whenever a model decides to call it, and an agent in a retry loop calls far faster
# than a human would. Set PGOPS_RATE_LIMIT_RPS=0 to disable.
PGOPS_RATE_LIMIT_RPS=10
PGOPS_RATE_LIMIT_BURST=20
